# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
*.tsbuildinfo

# Capacitor — native build artifacts only
# This is a Capacitor PLUGIN repo (not an app), so the native source under
# ios/Sources/, ios/Tests/, and android/src/ MUST be tracked (npm ships them
# via the `files` allowlist; git is their source of truth). Only ignore the
# generated build outputs and IDE state below.
#
# iOS build outputs / IDE state
ios/Pods/
ios/.build/
ios/build/
ios/DerivedData/
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
# Android build outputs / IDE state
android/.gradle/
android/build/
android/captures/
android/local.properties
android/.externalNativeBuild/
android/.cxx/
android/**/*.iml
android/.idea/
# Electron is not implemented; if a build tree appears later, keep it out of git.
electron/build/
electron/dist/
electron/node_modules/

# Testing
coverage/
.nyc_output

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Environment
# PRIVATE repo — .env / secrets ARE tracked in git (owner's standing rule).
# Real env files stay tracked; only generated/template noise stays ignored.
# (.env.example / .env.sample / .env.template remain tracked as-is.)

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Package files
*.tgz

# Lock files (keep only one)
package-lock.json
pnpm-lock.yaml
# Firebase hosting cache (per 2026-04-22: untracked across all projects)
.firebase/hosting.*

# Yarn 4 (Berry) — ignore cache/state, allow patches/plugins/releases/sdks/versions
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Nested sub-project (examples/*) Yarn artifacts — never commit
**/.yarn/cache
**/.yarn/install-state.gz
**/.yarn/build-state.yml

# Additional recoverable build/cache artifacts (kept out of git)
www/
.output/
.vite/
.next/
.docusaurus/
.wxt/
*.iml

# Custom ignore rules (owner standard)
*.ignore.*
project-record-ignore/
