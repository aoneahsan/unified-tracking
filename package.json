{
  "name": "unified-tracking",
  "version": "3.3.1",
  "description": "One analytics and error-tracking API across 16 providers for web, React and Capacitor apps",
  "type": "module",
  "sideEffects": [
    "./dist/esm/src/providers/**/*.provider.js"
  ],
  "main": "./dist/esm/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/esm/src/index.d.ts",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "android/variables.gradle",
    "android/proguard-rules.pro",
    "dist/",
    "ios/Sources/",
    "ios/Tests/",
    "Package.swift",
    "UnifiedTracking.podspec",
    "bin/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AI-INTEGRATION-GUIDE.md"
  ],
  "bin": {
    "unified-tracking-setup": "./bin/setup.cjs"
  },
  "author": {
    "name": "Ahsan Mahmood",
    "email": "aoneahsan@gmail.com",
    "url": "https://aoneahsan.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoneahsan/unified-tracking.git"
  },
  "bugs": {
    "url": "https://github.com/aoneahsan/unified-tracking/issues"
  },
  "homepage": "https://unified-tracking-docs.aoneahsan.com",
  "funding": "https://aoneahsan.com/payment?project-id=unified-tracking&project-identifier=unified-tracking",
  "keywords": [
    "analytics",
    "error-tracking",
    "capacitor",
    "react",
    "typescript",
    "google-analytics",
    "mixpanel",
    "posthog",
    "amplitude",
    "sentry",
    "consent",
    "cross-platform"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/src/index.d.ts",
      "import": "./dist/esm/src/index.js"
    },
    "./react": {
      "types": "./dist/esm/src/react/index.d.ts",
      "import": "./dist/esm/src/react/index.js"
    },
    "./capacitor": {
      "types": "./dist/esm/src/capacitor/index.d.ts",
      "import": "./dist/esm/src/capacitor/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "verify": "yarn verify:ios && yarn verify:android && yarn verify:web",
    "verify:ios": "cd ios && pod install && xcodebuild -workspace Plugin.xcworkspace -scheme Plugin -configuration Debug CODE_SIGN_IDENTITY=\"\" CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO",
    "verify:android": "cd android && ./gradlew clean build test",
    "verify:web": "yarn build",
    "lint": "yarn eslint && yarn prettier --check",
    "fmt": "yarn eslint --fix && yarn prettier --write",
    "eslint": "eslint .",
    "prettier": "prettier \"**/*.{css,html,ts,js,java,md,json,yml,yaml}\"",
    "docgen": "docgen --api UnifiedTrackingPlugin --output-json dist/docs.json",
    "build": "yarn clean && tsc -p tsconfig.build.json",
    "build:nodoc": "yarn build",
    "build:docgen": "yarn clean && yarn docgen && tsc -p tsconfig.build.json",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "dev": "yarn clean && tsc --watch",
    "prepublishOnly": "yarn build",
    "prepack": "yarn build",
    "typecheck": "tsc --noEmit",
    "type-check": "yarn typecheck",
    "prepare": "husky || true",
    "release": "yarn build && yarn lint && npm publish",
    "release:dry": "yarn build && yarn lint && npm publish --dry-run",
    "size-check": "yarn build && bundlesize",
    "audit:fix": "yarn audit --fix",
    "deps:check": "yarn outdated",
    "deps:update": "yarn upgrade --latest",
    "example:install": "cd examples/react-app && yarn install",
    "example:dev": "cd examples/react-app && yarn dev",
    "example:build": "cd examples/react-app && yarn build"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "swiftlint": "@ionic/swiftlint-config",
  "engines": {
    "node": ">=24.13.0"
  },
  "peerDependencies": {
    "@capacitor/core": "^7.4.3 || ^8.0.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@capacitor/core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "prettier-plugin-java": "^2.9.7",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
